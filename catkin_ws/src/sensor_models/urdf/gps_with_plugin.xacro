<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- GPS modülünü ve Gazebo plugin'ini birlikte tanımlayan makro -->
  <xacro:macro name="gps_with_plugin" params="parent x y z">

    <!-- Fiziksel GPS link ve joint -->
    <joint name="gps_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gps_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>

    <link name="gps_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.02"/>
        </geometry>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.05 0.05 0.02"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <!-- Gazebo plugin tanımı: TAM REFERANS burası -->
    <gazebo reference="gps_link">
      <plugin name="hector_gazebo_ros_gps" filename="libhector_gazebo_ros_gps.so">
        <updateRate>10.0</updateRate>
        <bodyName>gps_link</bodyName>
        <frameId>gps_link</frameId>
        <topicName>/gps/fix</topicName>
        <velocityTopicName>/gps/fix_velocity</velocityTopicName>
        <referenceLatitude>41.0082</referenceLatitude>
        <referenceLongitude>28.9784</referenceLongitude>
        <drift>0.0001 0.0001 0.0001</drift>
        <gaussianNoise>0.01 0.01 0.01</gaussianNoise>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
