<?xml version="1.0"?>
<launch>

  <!-- 1) URDF'i robot_description olarak yükle -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find hector_quadrotor_description)/urdf/quadrotor.urdf.xacro'" />

  <!-- 2) URDF modeli Gazebo'ya spawn et -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model quadrotor" />

</launch>
